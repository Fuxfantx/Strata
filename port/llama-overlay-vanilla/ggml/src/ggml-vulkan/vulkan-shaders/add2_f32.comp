#version 450

// Adds one float vector into another in place: d += b.  The two plane projection path uses it to fold the low plane's
// partial result into the high plane's, and the in place form keeps the destination bound only once.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) buffer D { float data_d[]; };
layout (binding = 1) readonly buffer B { float data_b[]; };

#if defined(PARAM_BLOCK_ENABLED)
#define PARAM_BLOCK_BINDING 12
layout (binding = PARAM_BLOCK_BINDING, std430) readonly buffer parameter
#else
layout (push_constant) uniform parameter
#endif
{
    uint n;
};

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i < n) {
        data_d[i] = data_d[i] + data_b[i];
    }
}
