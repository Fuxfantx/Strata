#version 450

// Reads a float buffer and writes every value back unchanged.  Built to test whether warming an activation buffer in
// cache helps the consumer: it measured neutral, so nothing dispatches it today.  The pipeline is kept because the
// generated shader header is checked in and regenerating it is a separate change.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) buffer D { float data_d[]; };

#if defined(PARAM_BLOCK_ENABLED)
#define PARAM_BLOCK_BINDING 12
layout (binding = PARAM_BLOCK_BINDING, std430) readonly buffer parameter
#else
layout (push_constant) uniform parameter
#endif
{
    uint n;
};

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i < n) {
        data_d[i] = data_d[i];
    }
}
