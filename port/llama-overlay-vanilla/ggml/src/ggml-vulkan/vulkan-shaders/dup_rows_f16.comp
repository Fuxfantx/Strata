#version 450

// Copies an f16 activation matrix [K, n] into [2K, n], repeating every row.  The two plane projection path uses this
// to turn two matrix multiplies into one wider one: A holds the two weight planes interleaved along K, and B holds each
// activation twice, so the kernel's own K accumulation sums both planes.

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer S { uint16_t data_s[]; };
layout (binding = 1) writeonly buffer D { uint16_t data_d[]; };

#if defined(PARAM_BLOCK_ENABLED)
#define PARAM_BLOCK_BINDING 12
layout (binding = PARAM_BLOCK_BINDING, std430) readonly buffer parameter
#else
layout (push_constant) uniform parameter
#endif
{
    uint total;   // rows * k
    uint k;
};

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= total) {
        return;
    }
    const uint row = i / k;
    const uint col = i - row * k;
    const uint16_t v = data_s[i];
    data_d[row * 2u * k + col] = v;
    data_d[row * 2u * k + k + col] = v;
}
