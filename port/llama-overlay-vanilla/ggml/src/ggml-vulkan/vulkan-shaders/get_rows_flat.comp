#version 450

#include "types.glsl"
#include "generic_binary_head.glsl"

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

// Narrow rows: one flat range over (row, element), so every lane of a workgroup is active.  The row-major kernel
// dispatches x over ne00 and leaves 512 - ne00 lanes idle for each row.
void main() {
    const uint total = p.ne20 * p.ne21 * p.ne22 * p.ne23;
    const uint idx = get_idx();

    if (idx >= total) {
        return;
    }

    const uint i00 = idx % p.ne20;
    const uint r = idx / p.ne20;
    const uint i10 = r % p.ne10;
    const uint i11 = (r / p.ne10) % p.ne11;
    const uint i12 = r / (p.ne10 * p.ne11);

    const uint i01 = data_b[get_boffset() + i10*p.nb10 + i11*p.nb11 + i12*p.nb12];

    const uint a_offset = get_aoffset() + i01*p.nb01 + i11*p.nb02 + i12*p.nb03;
    const uint d_offset = get_doffset() + i10*p.nb21 + i11*p.nb22 + i12*p.nb23;

    data_d[d_offset + i00] = D_TYPE(TEMP_TYPE(data_a[a_offset + i00]));
}
