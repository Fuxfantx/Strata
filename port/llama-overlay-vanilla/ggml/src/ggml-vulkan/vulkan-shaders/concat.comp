#version 450

#include "types.glsl"
#include "generic_binary_head.glsl"

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint idx = (gl_GlobalInvocationID.z << 18) + (gl_GlobalInvocationID.y << 9) + gl_GlobalInvocationID.x;
    const int dim = p.param3;

    if (idx >= p.ne) {
        return;
    }

    const uint i3 = idx / (p.ne22*p.ne21*p.ne20);
    const uint i3_offset = i3 * p.ne22*p.ne21*p.ne20;
    const uint i2 = (idx - i3_offset) / (p.ne21*p.ne20);
    const uint i2_offset = i2*p.ne21*p.ne20;
    // magic-div-not-applicable: idx scales with the element count, so the wrapping magic form would overflow.
    const uint i1 = (idx - i3_offset - i2_offset) / p.ne20;
    const uint i0 = idx - i3_offset - i2_offset - i1*p.ne20;

    // Packed concatenation along dim 0 is two contiguous copies per row, so the three divisions and the per element
    // source test can be replaced by one division for four units.
    // The fast path walks four units at a time and derives the row from the group start, which is only valid when
    // a group cannot straddle two rows: with a row length that is not a multiple of four, the second row of a
    // straddling group was read from the first row's source offsets (odd dim-0 shapes came back ~11% off).
    if (p.param3 == 0 && (p.ne20 % 4u) == 0u && p.nb00 == 1u && p.nb10 == 1u && p.nb20 == 1u &&
        p.nb01 == p.ne00 && p.nb11 == p.ne10 && p.nb21 == p.ne20 &&
        p.nb02 == p.ne00 * p.ne01 && p.nb12 == p.ne10 * p.ne11 && p.nb22 == p.ne20 * p.ne21 &&
        p.nb03 == p.ne00 * p.ne01 * p.ne02 && p.nb13 == p.ne10 * p.ne11 * p.ne12 &&
        p.nb23 == p.ne20 * p.ne21 * p.ne22) {
        const uint rows = p.ne21 * p.ne22 * p.ne23;
        const uint per_row = p.ne20;
        const uint total = rows * per_row;
        const uint base = idx * 4u;
        if (base >= total) {
            return;
        }
        const uint row = base / per_row;
        const uint col = base - row * per_row;
        const uint a_base = get_aoffset() + row * p.ne00;
        const uint b_base = get_boffset() + row * p.ne10;
        const uint d_base = get_doffset() + row * per_row + col;
        const uint a_take = col < p.ne00 ? min(4u, p.ne00 - col) : 0u;
        [[unroll]] for (uint k = 0; k < 4u; ++k) {
            if (base + k >= total) {
                break;
            }
            if (k < a_take) {
                data_d[d_base + k] = D_TYPE(data_a[a_base + col + k]);
            } else {
                data_d[d_base + k] = D_TYPE(data_b[b_base + (col + k - p.ne00)]);
            }
        }
        return;
    }

    uint o[4] = {0, 0, 0, 0};
    o[dim] = dim == 0 ? p.ne00 : (dim == 1 ? p.ne01 : (dim == 2 ? p.ne02 : p.ne03));

    const uint src0_idx = i3*p.nb03 + i2*p.nb02 + i1*p.nb01 + i0*p.nb00;
    const uint src1_idx = (i3 - o[3])*p.nb13 + (i2 - o[2])*p.nb12 + (i1 - o[1])*p.nb11 + (i0 - o[0])*p.nb10;
    const uint dst_idx = i3*p.nb23 + i2*p.nb22 + i1*p.nb21 + i0*p.nb20;

    const bool is_src0 = i0 < p.ne00 && i1 < p.ne01 && i2 < p.ne02 && i3 < p.ne03;

#ifndef OPTIMIZATION_ERROR_WORKAROUND
    data_d[get_doffset() + dst_idx] = D_TYPE(is_src0 ? data_a[get_aoffset() + src0_idx] : data_b[get_boffset() + src1_idx]);
#else
    if (is_src0) {
        data_d[get_doffset() + dst_idx] = data_a[get_aoffset() + src0_idx];
    } else {
        data_d[get_doffset() + dst_idx] = data_b[get_boffset() + src1_idx];
    }
#endif
}
